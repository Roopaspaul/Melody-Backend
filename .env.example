# MelodyMart Backend Environment Variables Example
# Duplicate this file to .env and fill in the values for your local environment

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/melodymart_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Gmail SMTP Email Configuration (For OTP Verifications)
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-gmail-app-password
